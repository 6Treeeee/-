{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hkg1"
  ],
  "buildCommand": "node scripts/package-ocr-runtime.mjs && npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{artifacts/douyin/verified-profile.json,assets/whisper/*,assets/ocr/python/**,assets/ocr/manifest.json,src/services/hard-subtitle-worker.py}",
      "regions": [
        "sfo1"
      ]
    },
    "api/a2a.js": {
      "maxDuration": 30
    },
    "api/agent-card.js": {
      "maxDuration": 10
    },
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/oauth-protected-resource.js": {
      "maxDuration": 10
    },
    "api/workflow-flow.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "__wkf_workflow_*",
          "retryAfterSeconds": 5,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/workflow-step.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "__wkf_step_*",
          "retryAfterSeconds": 5,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/douyin-region-hnd.js": {
      "maxDuration": 30,
      "regions": [
        "hnd1"
      ]
    },
    "api/douyin-region-kix.js": {
      "maxDuration": 30,
      "regions": [
        "kix1"
      ]
    },
    "api/douyin-region-hkg.js": {
      "maxDuration": 30,
      "regions": [
        "hkg1"
      ]
    },
    "api/douyin-region-sin.js": {
      "maxDuration": 30,
      "regions": [
        "sin1"
      ]
    },
    "api/douyin-region-iad.js": {
      "maxDuration": 30,
      "regions": [
        "iad1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/tasks",
      "destination": "/api/a2a?route=/tasks"
    },
    {
      "source": "/tasks/:path*",
      "destination": "/api/a2a?route=/tasks/:path*"
    },
    {
      "source": "/agent-card",
      "destination": "/api/agent-card"
    }
  ]
}
